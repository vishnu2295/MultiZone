<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="ReverseProxyInboundRule1" stopProcessing="true">
                    <match url="apirma/(.*)" ignoreCase="false" />
                    <action type="Rewrite" url="http://localhost:8443/{R:0}" logRewrittenUrl="true" />
                </rule>
                <rule name="BrokerPortalProxy" stopProcessing="true">
                    <match url="^brokerPortal(/.*)?$" ignoreCase="false" />
                    <action type="Rewrite" url="http://localhost:3001/brokerPortal/{R:1}" logRewrittenUrl="true" />
                </rule>
                <rule name="ReverseProxyInboundRule2" stopProcessing="true">
                    <match url="(.*)" ignoreCase="false" />
                    <action type="Rewrite" url="http://localhost:3000/{R:1}" logRewrittenUrl="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
